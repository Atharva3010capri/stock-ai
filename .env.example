# Copy this file to .env and fill in your values.
# Never commit .env to git.

# Google Gemini API key (free tier) from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model to use. Must be a model available on the free tier.
GEMINI_MODEL=gemini-3.5-flash

# Backup model used when the main one is busy (503). Leave empty to disable.
GEMINI_FALLBACK_MODEL=gemini-3-flash-preview

# How many times to retry a Gemini call after a rate limit (HTTP 429)
LLM_MAX_RETRIES=4

# Local embedding model (downloaded once by sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chunking: size in characters and overlap between neighbouring chunks
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval: how many chunks to fetch and the minimum similarity (0-1)
# a chunk must reach to count as relevant. Below this, the app says
# "not found in the reports" instead of guessing.
TOP_K=5
RELEVANCE_THRESHOLD=0.25
